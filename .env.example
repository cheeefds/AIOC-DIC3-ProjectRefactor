# Google AI Studio API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Target Model Identifier in Google AI Studio
# e.g., gemini-2.5-flash-lite, gemini-2.0-flash-lite, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: Generation temperature (low temperature 0.1-0.2 recommended for deterministic adherence)
GEMINI_TEMPERATURE=0.2
